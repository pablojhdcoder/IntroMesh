# Meta Model API — servidor. No uses el prefijo NEXT_PUBLIC_.
# Panel: https://dev.meta.ai → API keys → Create API key
MODEL_API_KEY=

# Opcionales. Los valores por defecto coinciden con la documentación vigente.
META_MODEL_BASE_URL=https://api.meta.ai/v1
META_MODEL_ID=muse-spark-1.3
META_MODEL_MAX_REQUESTS_PER_MINUTE=10

# Supabase. La anon key es pública y debe ir protegida con RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Azure OpenAI embeddings (servidor). Nunca uses el prefijo NEXT_PUBLIC_.
# Despliegue text-embedding-3-small; vectores nativos de 1536 dims (sin `dimensions`).
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_API_VERSION=2024-10-21

# Secreto de servidor. Nunca en el cliente.
SUPABASE_SERVICE_ROLE_KEY=

# live: datos reales. demo: permite fixtures sintéticos etiquetados. No fabrica texto del modelo.
INTROMESH_DATA_MODE=live

# 1 permite crear eventos desde el onboarding. Sin este valor, el alta de eventos queda cerrada.
INTROMESH_ALLOW_EVENT_CREATE=

# Wallet (servidor, opcional). Sin estos valores las rutas devuelven 503 y la UI oculta el botón.
GOOGLE_WALLET_ISSUER_ID=
GOOGLE_WALLET_SERVICE_ACCOUNT_EMAIL=
GOOGLE_WALLET_PRIVATE_KEY=
APPLE_PASS_TYPE_ID=
APPLE_TEAM_ID=
APPLE_PASS_CERT_PEM=
APPLE_PASS_KEY_PEM=
APPLE_PASS_KEY_PASSPHRASE=
APPLE_WWDR_PEM=
